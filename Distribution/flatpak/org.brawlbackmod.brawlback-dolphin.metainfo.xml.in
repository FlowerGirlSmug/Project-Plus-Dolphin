<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
	<id>org.brawlbackmod.brawlback-dolphin</id>
	<name>Brawlback Dolphin</name>
	<summary>GameCube / Wii / Triforce Emulator for Brawl rollback</summary>
	<metadata_license>CC-BY-SA-3.0</metadata_license>
	<project_license>GPL-2.0+</project_license>
	<supports>
		<control>pointing</control>
		<control>keyboard</control>
		<control>gamepad</control>
	</supports>
	<description>
		<p>
      A fork of the Dolphin emulator for playing the Brawl and Brawl mod's with rollback.
    </p>
	</description>
	<provides>
		<binary>brawlback-dolphin</binary>
		<id>org.brawlbackmod.brawlback-dolphin.desktop</id>
	</provides>
	<releases>
		<release version="3.1.5" date="2025-10-12"/>
		<release version="3.1.2" date="2025-05-02"/>
		<release version="3.1.1" date="2025-05-02"/>
		<release version="3.1.0" date="2025-04-23"/>
		<release version="3.0.5" date="2024-09-23"/>
		<release version="3.0.2" date="2024-06-27"/>
		<release version="3.0.1" date="2024-06-24"/>
		<release version="3.0" date="2024-06-24"/>
		<release version="2.5.2" date="2024-06-15"/>
	</releases>
	<launchable type="desktop-id">org.brawlbackmod.brawlback-dolphin.desktop</launchable>
</component>
